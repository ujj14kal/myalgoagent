# Copy to .env.local for local development.

# Google Analytics 4 Measurement ID (public — safe to expose to the browser).
# Get it from analytics.google.com -> Admin -> Data Streams -> your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Postgres connection string (AWS RDS in production). Do not append
# ?sslmode=... — TLS is configured explicitly in src/lib/prisma.ts against
# certs/rds-global-bundle.pem, and a conflicting sslmode query param breaks it.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth "Web application" client (different from any Desktop/CLI
# OAuth client you may have for other tools). Create in Google Cloud
# Console -> APIs & Services -> Credentials. Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://myalgoagent.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
