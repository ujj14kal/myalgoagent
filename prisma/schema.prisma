generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  SUSPENDED
}

// Staff access to the admin portal (/admin). Null for every normal user.
enum AdminRole {
  OWNER // everything, including managing the team
  ADMIN // users, announcements, jobs, system
  SUPPORT // inbox and read-only user lookups
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  username     String?    @unique
  phone        String?
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  adminRole       AdminRole?
  suspendedAt     DateTime?
  suspendedReason String?
  // Last time the user opened the app (updated at most every few minutes).
  lastSeenAt      DateTime?
  // Real orders are off for every account until an owner switches them on
  // (admin portal), and only then after the user confirms on Live Trading.
  liveTradingEnabledAt DateTime?
  // The account's own static IP — one client, one IP (a broker/SEBI rule), so
  // unique. Not assigned yet: it comes with the paid plan once the Fargate +
  // NAT setup is live; until then everyone trades from the shared relay IP.
  liveStaticIp         String?   @unique
  liveTermsAcceptedAt  DateTime?

  agentName           String?
  tutorialCompletedAt DateTime?

  // Risk/safety notifications (RISK_EVENT, SESSION_STOPPED) are never
  // gated by a preference — only the two high-volume, non-critical types
  // are user-toggleable, so a user can't accidentally silence a kill-switch
  // or risk-limit alert.
  notifyOrderFilled Boolean @default(true)
  notifySignalAlert Boolean @default(true)

  accounts            Account[]
  sessions            Session[]
  watchlistItems      WatchlistItem[]
  strategies          Strategy[]
  backtestRuns        BacktestRun[]
  paperSessions       PaperSession[]
  riskSettings        RiskSettings?
  riskEvents          RiskEvent[]
  chartLayouts        ChartLayout[]
  notifications       Notification[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  feedback            Feedback[]
  supportCases        SupportCase[]
  agentConversations  AgentConversation[]
  brokerConnections   BrokerConnection[]
  liveOrders          LiveOrder[]
  optionStrategies    OptionStrategy[]
  optionBacktestRuns  OptionBacktestRun[]
  optionForwardTests  OptionForwardTest[]
}

enum OtpPurpose {
  ACCOUNT_DELETION
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Where a support case or piece of feedback is in its life: OPEN needs a
// reply from us, PENDING is waiting on the user, RESOLVED is done.
enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  page      String
  message   String   @db.Text
  createdAt DateTime @default(now())

  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  assigneeId     String?
  tags           String[]       @default([])
  lastActivityAt DateTime       @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, lastActivityAt])
}

model SupportCase {
  id         String   @id @default(cuid())
  caseNumber Int      @unique @default(autoincrement())
  userId     String?
  email      String
  subject    String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  assigneeId     String?
  tags           String[]       @default([])
  lastActivityAt DateTime       @default(now())

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, lastActivityAt])
}

enum SupportAuthor {
  USER // the person who raised it
  STAFF // a reply from our team (the user sees it)
  NOTE // internal note (never shown to the user)
}

// One message in a support case or feedback thread, after the first one
// (which lives on the case/feedback row itself).
model SupportMessage {
  id          String        @id @default(cuid())
  caseId      String?
  feedbackId  String?
  author      SupportAuthor
  authorId    String? // user id of whoever wrote it (staff or the user)
  authorName  String // kept so the thread reads right even if that account is deleted
  body        String        @db.Text
  // Email delivery of a staff reply: "sent", "failed: <reason>" or null (in-app only / not a reply).
  emailStatus String?
  createdAt   DateTime      @default(now())

  supportCase SupportCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  feedback    Feedback?    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([feedbackId, createdAt])
}

// Everything staff do in the admin portal, including viewing a user's
// details. Kept without a foreign key so the trail survives account deletion.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String // e.g. "user.suspend", "case.reply", "user.view"
  targetType String?
  targetId   String?
  summary    String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

enum AnnouncementLevel {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

// A banner shown across the app (e.g. planned maintenance), optionally also
// sent to everyone as a notification.
model Announcement {
  id          String            @id @default(cuid())
  title       String
  body        String            @db.Text
  level       AnnouncementLevel @default(INFO)
  link        String?
  startsAt    DateTime          @default(now())
  endsAt      DateTime?
  active      Boolean           @default(true)
  notifiedAt  DateTime?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([active, startsAt])
}

// One run of a scheduled job (paper-trade sync, account purge), so the admin
// portal can show whether they're healthy without opening AWS.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?
  error      String?

  @@index([job, startedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Instrument {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  exchange  String
  sector    String?
  createdAt DateTime @default(now())

  watchlistItems WatchlistItem[]
  strategies     Strategy[]
  chartLayouts   ChartLayout[]
}

model WatchlistItem {
  id           String   @id @default(cuid())
  userId       String
  instrumentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  // Soft-deleted — "Delete" no longer removes a strategy outright, it
  // moves here with a Restore / Delete forever choice, same safety net as
  // an OS trash bin. Only permanentlyDeleteStrategyAction ever actually
  // removes the row, and only when it's already in this state.
  DELETED
}

enum StrategyMode {
  NO_CODE
  CODE
  WEBHOOK
}

enum StrategyDirection {
  LONG
  SHORT
}

model Strategy {
  id                  String             @id @default(cuid())
  userId              String
  instrumentId        String
  name                String
  // Lowercase, trimmed copy of `name` — the actual duplicate-name check
  // is case-insensitive (per product decision, "My Strategy" and "my
  // strategy" collide), and Postgres unique constraints are always
  // case-sensitive, so the constraint has to target this normalized
  // column rather than `name` itself. Kept in sync with `name` by the
  // application layer (strategy-actions.ts) on every create/update —
  // there is no case-insensitive collation available to enforce this at
  // the database level without one.
  nameNormalized      String
  mode                StrategyMode
  // Whether the entry condition opens a long (buy first) or short (sell
  // first) position — fixed per strategy, same as risk/sizing config below.
  direction           StrategyDirection  @default(LONG)
  entryCondition      Json
  exitCondition       Json
  entrySource         String?            @db.Text
  exitSource          String?            @db.Text
  // Only set when mode is WEBHOOK. Only the sha256 hash is ever stored — the
  // raw token is shown to the user once, embedded in their webhook URL, the
  // same one-way-hash pattern already used for password-reset/email-change
  // tokens (src/lib/account-actions.ts) and the magic-link route.
  webhookTokenHash    String?            @unique
  webhookEnabled      Boolean            @default(false)
  // Execution/risk configuration, fixed at strategy-creation time rather
  // than re-specified per backtest run or paper session — so whatever gets
  // backtested is identical to what would run live. BacktestRun/PaperSession
  // still snapshot a copy of these at run time, same pattern as they already
  // do for entryCondition/exitCondition.
  positionSizingMode  PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue Float?
  stopLossEnabled     Boolean            @default(false)
  stopLossUnit        RiskUnit?
  stopLossValue       Float?
  targetEnabled       Boolean            @default(false)
  targetUnit          RiskUnit?
  targetValue         Float?
  trailingSlEnabled   Boolean            @default(false)
  trailingSlUnit      RiskUnit?
  trailingSlValue     Float?
  maxPyramidEntries   Int                @default(1)
  // Candle timeframe the strategy runs on ("1d", "15m", "3m", "4h" …). Intraday
  // timeframes enable time-of-day rules; the session fields apply only to them.
  timeframe           String             @default("1d")
  // IST minute of day: no new entries at/after it; open positions squared off at it.
  noEntryAfterMinute  Int?
  squareOffMinute     Int?
  // INTRADAY (squared off the same day) or DELIVERY (may be held overnight, long only).
  productType         String             @default("DELIVERY")
  // Entry orders: MARKET (next candle's open) or LIMIT (a DAY order at a % from the
  // signal price, or a fixed ₹ price).
  orderType           String             @default("MARKET")
  limitMode           String?
  limitValue          Float?
  status              StrategyStatus     @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument    Instrument     @relation(fields: [instrumentId], references: [id])
  backtestRuns  BacktestRun[]
  paperSessions PaperSession[]
  webhookAlerts WebhookAlert[]

  @@unique([userId, nameNormalized])
}

enum PositionSizingMode {
  FULL_CAPITAL
  FIXED_QUANTITY
  FIXED_CAPITAL
  PERCENT_OF_CAPITAL
}

enum RiskUnit {
  PERCENT
  POINTS
  ATR_MULTIPLE
}

model BacktestRun {
  id                  String             @id @default(cuid())
  userId              String
  strategyId          String?
  strategyName        String
  instrumentSymbol    String
  direction           StrategyDirection  @default(LONG)
  startingCapital     Float
  brokeragePercent    Float
  slippagePercent     Float
  positionSizingMode  PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue Float?
  stopLossEnabled     Boolean            @default(false)
  stopLossUnit        RiskUnit?
  stopLossValue       Float?
  targetEnabled       Boolean            @default(false)
  targetUnit          RiskUnit?
  targetValue         Float?
  trailingSlEnabled   Boolean            @default(false)
  trailingSlUnit      RiskUnit?
  trailingSlValue     Float?
  maxPyramidEntries   Int                @default(1)
  // Candle timeframe the strategy runs on ("1d", "15m", "3m", "4h" …). Intraday
  // timeframes enable time-of-day rules; the session fields apply only to them.
  timeframe           String             @default("1d")
  // IST minute of day: no new entries at/after it; open positions squared off at it.
  noEntryAfterMinute  Int?
  squareOffMinute     Int?
  // INTRADAY (squared off the same day) or DELIVERY (may be held overnight, long only).
  productType         String             @default("DELIVERY")
  // Entry orders: MARKET (next candle's open) or LIMIT (a DAY order at a % from the
  // signal price, or a fixed ₹ price).
  orderType           String             @default("MARKET")
  limitMode           String?
  limitValue          Float?
  range               String
  entryCondition      Json
  exitCondition       Json
  totalReturnPct      Float
  cagrPct             Float
  winRatePct          Float
  profitFactor        Float
  maxDrawdownPct      Float
  sharpeRatio         Float
  expectancy          Float
  tradeCount          Int
  equityCurve         Json
  createdAt           DateTime           @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  trades   BacktestTrade[]
}

model BacktestTrade {
  id            String @id @default(cuid())
  backtestRunId String
  entryTime     Int
  entryPrice    Float
  exitTime      Int
  exitPrice     Float
  quantity      Float
  grossPnl      Float
  fees          Float
  netPnl        Float
  netPnlPct     Float
  holdingBars   Int

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)
}

enum PaperSessionStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum PaperOrderSide {
  BUY
  SELL
}

model PaperSession {
  id                       String             @id @default(cuid())
  userId                   String
  strategyId               String?
  strategyName             String
  instrumentSymbol         String
  direction                StrategyDirection  @default(LONG)
  entryCondition           Json
  exitCondition            Json
  startingCapital          Float
  brokeragePercent         Float
  slippagePercent          Float
  positionSizingMode       PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue      Float?
  stopLossEnabled          Boolean            @default(false)
  stopLossUnit             RiskUnit?
  stopLossValue            Float?
  targetEnabled            Boolean            @default(false)
  targetUnit               RiskUnit?
  targetValue              Float?
  trailingSlEnabled        Boolean            @default(false)
  trailingSlUnit           RiskUnit?
  trailingSlValue          Float?
  maxPyramidEntries        Int                @default(1)
  // Candle timeframe the strategy runs on ("1d", "15m", "3m", "4h" …). Intraday
  // timeframes enable time-of-day rules; the session fields apply only to them.
  timeframe           String             @default("1d")
  // IST minute of day: no new entries at/after it; open positions squared off at it.
  noEntryAfterMinute  Int?
  squareOffMinute     Int?
  // INTRADAY (squared off the same day) or DELIVERY (may be held overnight, long only).
  productType         String             @default("DELIVERY")
  // Entry orders: MARKET (next candle's open) or LIMIT (a DAY order at a % from the
  // signal price, or a fixed ₹ price).
  orderType           String             @default("MARKET")
  limitMode           String?
  limitValue          Float?
  // A resting limit entry order carried between syncs.
  pendingLimitPrice      Float?
  pendingLimitExpiresDay Int?
  pendingLimitFromTime   Int?
  // Alert-only sessions detect and notify on entry/exit signals without
  // ever placing an order or touching cash/position state.
  alertOnly                Boolean            @default(false)
  cash                     Float
  positionEntryTime        Int?
  positionEntryPrice       Float?
  positionQuantity         Float?
  // Persisted so a resumed session's trailing-stop/target math survives
  // across syncs instead of resetting each time (favorableExtreme in
  // particular must carry forward — resetting it to entryPrice every sync
  // would silently defeat the trailing stop). pyramidCount carries forward
  // for the same reason — how many entries have already stacked into the
  // current position.
  positionFavorableExtreme Float?
  positionStopLossPrice    Float?
  positionTargetPrice      Float?
  positionPyramidCount     Int                @default(1)
  lastSyncedTime           Int?
  status                   PaperSessionStatus @default(ACTIVE)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  orders   PaperOrder[]
}

model PaperOrder {
  id             String         @id @default(cuid())
  paperSessionId String
  side           PaperOrderSide
  time           Int
  price          Float
  quantity       Float
  fees           Float
  netPnl         Float?
  createdAt      DateTime       @default(now())

  paperSession PaperSession  @relation(fields: [paperSessionId], references: [id], onDelete: Cascade)
  webhookAlert WebhookAlert?
}

// Append-only log of every call received at a strategy's webhook URL —
// written even when parsing fails, so the "Recent Signals" panel can always
// answer "why did/didn't this fire," the single most common support question
// this kind of feature generates.
model WebhookAlert {
  id           String          @id @default(cuid())
  strategyId   String
  receivedAt   DateTime        @default(now())
  rawPayload   String          @db.Text
  parsedAction PaperOrderSide?
  parseError   String?
  executed     Boolean         @default(false)
  paperOrderId String?         @unique

  strategy   Strategy    @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  paperOrder PaperOrder? @relation(fields: [paperOrderId], references: [id], onDelete: SetNull)

  @@index([strategyId, receivedAt])
}

model RiskSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  killSwitchEnabled    Boolean  @default(false)
  maxLossPercent       Float?
  maxConsecutiveLosses Int?
  // Live-trading caps (checked before every real order; defaults apply when null).
  liveMaxOrderValue    Float?
  liveMaxOrdersPerDay  Int?
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RiskEventType {
  KILL_SWITCH_BLOCKED
  MAX_LOSS_HIT
  MAX_CONSECUTIVE_LOSSES_HIT
}

model RiskEvent {
  id             String        @id @default(cuid())
  userId         String
  paperSessionId String?
  type           RiskEventType
  message        String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChartLayout {
  id           String   @id @default(cuid())
  userId       String
  instrumentId String
  config       Json
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

enum NotificationType {
  ORDER_FILLED
  RISK_EVENT
  SESSION_STOPPED
  SIGNAL_ALERT
  SUPPORT_REPLY
  ANNOUNCEMENT
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  message        String
  paperSessionId String?
  // Where the notification leads (e.g. a support thread), when not a paper session.
  link           String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conversations with the user's own agent (the AI assistant). Stored in
// India (this RDS instance); only the text of each exchange is sent to AWS
// Bedrock for processing. Deleted with the account via the cascade.
model AgentConversation {
  id        String         @id @default(cuid())
  userId    String
  title     String         @default("New conversation")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AgentMessageRole
  content        String
  // Which Bedrock model answered, and what it cost in tokens — lets usage
  // and spend be reported per user without asking AWS.
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  // True when the Bedrock guardrail blocked or rewrote the exchange (e.g. a
  // request for buy/sell advice).
  guardrailHit   Boolean          @default(false)
  // The user's rating of an assistant reply: 1 = helpful, -1 = not helpful.
  rating         Int?
  // An action the agent prepared for review (see src/lib/ai/proposals.ts),
  // with the user's decision recorded in its status.
  proposal       Json?
  createdAt      DateTime         @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum BrokerConnectionStatus {
  KEYS_SAVED // API key/secret stored, broker login not completed yet
  CONNECTED
  ERROR
}

// A user's link to their own broker account through the broker's official
// API (users bring their own API app — MyAlgoAgent is not an algo vendor).
// Every secret column holds AES-256-GCM ciphertext (src/lib/brokers/crypto.ts)
// bound to this user + broker; nothing here is ever sent to the browser.
model BrokerConnection {
  id     String                 @id @default(cuid())
  userId String
  broker String // catalog id: "dhan", "zerodha", "upstox", "fyers", "angelone"
  status BrokerConnectionStatus @default(KEYS_SAVED)

  apiKeyEnc      String
  apiSecretEnc   String?
  apiKeyHint     String // last 4 characters, for display
  brokerClientId String? // the user's client/user ID at the broker (not secret)

  accessTokenEnc String?
  tokenExpiresAt DateTime?
  accountName    String?
  connectedAt    DateTime?

  // One pending broker login at a time: the callback must match this state
  // and arrive within a few minutes of the login being started.
  pendingState     String?
  pendingStartedAt DateTime?

  // How this user logs in each day, when the broker offers a choice: null =
  // the broker's usual login, "totp" = Groww's API TOTP key (automatic),
  // "phone" = Upstox approval request (tap Approve in the Upstox app).
  loginMethod       String?
  // sha256 of this user's private Upstox notifier path, so the approval
  // webhook can find the right connection without revealing anything.
  notifierTokenHash String?   @unique

  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
}

enum LiveOrderSide {
  BUY
  SELL
}

// Our own lifecycle for a real broker order (each broker's statuses map onto it).
enum LiveOrderStatus {
  CREATED // recorded, not yet accepted by the broker
  OPEN // accepted, working at the exchange
  TRIGGER_PENDING // stop order waiting for its trigger
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED // refused by the broker or exchange
  FAILED // couldn't be sent (network, session, our checks)
}

// A real order sent to the user's broker. Trading records must be kept for
// five years, so an order is NOT deleted with the account: the user link is
// cleared (SetNull) and the email snapshot stays with the record.
model LiveOrder {
  id               String          @id @default(cuid())
  userId           String?
  userEmail        String
  broker           String
  // Our order reference, sent to the broker too — the idempotency key: a
  // retried request can never create a second order.
  clientRef        String          @unique
  brokerOrderId    String?
  exchange         String
  segment          String          @default("CASH")
  tradingSymbol    String
  instrumentSymbol String
  side             LiveOrderSide
  orderType        String // MARKET, LIMIT, SL, SL_M
  product          String // CNC (delivery), MIS (intraday)
  quantity         Int
  price            Float?
  triggerPrice     Float?
  status           LiveOrderStatus @default(CREATED)
  brokerStatus     String?
  filledQuantity   Int             @default(0)
  averagePrice     Float?
  // Why it exists: "test" (connectivity check), "entry", "exit", "manual".
  purpose          String
  reason           String?
  rejectReason     String?
  // The exchange-issued algo ID, once the platform is registered for one.
  exchangeAlgoId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  submittedAt      DateTime?
  closedAt         DateTime?

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events LiveOrderEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

// Every step in a live order's life — request, broker response, status
// change, cancel — for the audit trail.
model LiveOrderEvent {
  id      String   @id @default(cuid())
  orderId String
  at      DateTime @default(now())
  kind    String // created, submitted, status, cancel_requested, error
  detail  Json?

  order LiveOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
}

// A multi-leg options strategy, defined relative to the at-the-money strike so
// it can be replayed on any day: e.g. "sell the ATM straddle on the current
// weekly NIFTY expiry at 09:20, exit at 15:15 or on a ₹3,000 combined loss".
model OptionStrategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  // Option underlying as the exchange names it: NIFTY, BANKNIFTY, RELIANCE…
  underlying  String
  // [{ type: "CE"|"PE", side: "BUY"|"SELL", offset: strikes from ATM (+ above), lots }]
  legs        Json
  // WEEKLY_CURRENT (nearest expiry), WEEKLY_NEXT, MONTHLY (last expiry of the month).
  expiryRule  String   @default("WEEKLY_CURRENT")
  // IST minutes of day: entry and square-off.
  entryMinute Int      @default(560)
  exitMinute  Int      @default(915)
  // Days of the week to trade (1 = Monday … 5 = Friday).
  weekdays    Int[]    @default([1, 2, 3, 4, 5])
  // Stop-loss / target on the combined position: RUPEES, or PREMIUM_PCT (% of the premium paid/received).
  stopLossUnit  String?
  stopLossValue Float?
  targetUnit    String?
  targetValue   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs         OptionBacktestRun[]
  forwardTests OptionForwardTest[]

  @@index([userId])
}

// A backtest of an OptionStrategy on real historical option prices. Runs in
// chunks (a few weeks per request) — `cursor` is the next date to simulate.
model OptionBacktestRun {
  id                String   @id @default(cuid())
  userId            String
  strategyId        String?
  strategyName      String
  // The strategy as it was when the run started (so edits don't change past results).
  config            Json
  fromDate          String
  toDate            String
  brokeragePerOrder Float    @default(20)
  slippagePct       Float    @default(0.5)
  status            String   @default("RUNNING")
  cursor            String?
  daysDone          Int      @default(0)
  daysTotal         Int      @default(0)
  // One entry per traded day: legs, entry/exit prices, P&L, exit reason.
  trades            Json     @default("[]")
  stats             Json?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy OptionStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// An OptionStrategy forward tested each day with live option prices —
// hypothetical, no orders. Checked by the market-hours sync job: today's
// position is re-simulated from the day's minute candles up to now, so it
// follows exactly the backtest's rules.
model OptionForwardTest {
  id                String    @id @default(cuid())
  userId            String
  strategyId        String?
  strategyName      String
  config            Json
  status            String    @default("ACTIVE")
  brokeragePerOrder Float     @default(20)
  slippagePct       Float     @default(0.5)
  // Finished days (same shape as a backtest's trades).
  trades            Json      @default("[]")
  // Today's open position with its current (mark-to-market) P&L, or null.
  today             Json?
  lastCheckedAt     DateTime?
  stoppedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy OptionStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}
