generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  username     String?    @unique
  phone        String?
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  agentName           String?
  tutorialCompletedAt DateTime?

  accounts            Account[]
  sessions            Session[]
  watchlistItems      WatchlistItem[]
  strategies          Strategy[]
  backtestRuns        BacktestRun[]
  paperSessions       PaperSession[]
  riskSettings        RiskSettings?
  riskEvents          RiskEvent[]
  chartLayouts        ChartLayout[]
  notifications       Notification[]
  otpCodes            OtpCode[]
  passwordResetTokens PasswordResetToken[]
  feedback            Feedback[]
  supportCases        SupportCase[]
}

enum OtpPurpose {
  ACCOUNT_DELETION
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  page      String
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportCase {
  id         String   @id @default(cuid())
  caseNumber Int      @unique @default(autoincrement())
  userId     String?
  email      String
  subject    String
  message    String   @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Instrument {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  exchange  String
  sector    String?
  createdAt DateTime @default(now())

  watchlistItems WatchlistItem[]
  strategies     Strategy[]
  chartLayouts   ChartLayout[]
}

model WatchlistItem {
  id           String   @id @default(cuid())
  userId       String
  instrumentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StrategyMode {
  NO_CODE
  CODE
  WEBHOOK
}

enum StrategyDirection {
  LONG
  SHORT
}

model Strategy {
  id                  String             @id @default(cuid())
  userId              String
  instrumentId        String
  name                String
  mode                StrategyMode
  // Whether the entry condition opens a long (buy first) or short (sell
  // first) position — fixed per strategy, same as risk/sizing config below.
  direction           StrategyDirection  @default(LONG)
  entryCondition      Json
  exitCondition       Json
  entrySource         String?            @db.Text
  exitSource          String?            @db.Text
  // Only set when mode is WEBHOOK. Only the sha256 hash is ever stored — the
  // raw token is shown to the user once, embedded in their webhook URL, the
  // same one-way-hash pattern already used for password-reset/email-change
  // tokens (src/lib/account-actions.ts) and the magic-link route.
  webhookTokenHash    String?            @unique
  webhookEnabled      Boolean            @default(false)
  // Execution/risk configuration, fixed at strategy-creation time rather
  // than re-specified per backtest run or paper session — so whatever gets
  // backtested is identical to what would run live. BacktestRun/PaperSession
  // still snapshot a copy of these at run time, same pattern as they already
  // do for entryCondition/exitCondition.
  positionSizingMode  PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue Float?
  stopLossEnabled     Boolean            @default(false)
  stopLossUnit        RiskUnit?
  stopLossValue       Float?
  targetEnabled       Boolean            @default(false)
  targetUnit          RiskUnit?
  targetValue         Float?
  trailingSlEnabled   Boolean            @default(false)
  trailingSlUnit      RiskUnit?
  trailingSlValue     Float?
  maxPyramidEntries   Int                @default(1)
  status              StrategyStatus     @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument    Instrument     @relation(fields: [instrumentId], references: [id])
  backtestRuns  BacktestRun[]
  paperSessions PaperSession[]
  webhookAlerts WebhookAlert[]
}

enum PositionSizingMode {
  FULL_CAPITAL
  FIXED_QUANTITY
  FIXED_CAPITAL
  PERCENT_OF_CAPITAL
}

enum RiskUnit {
  PERCENT
  POINTS
  ATR_MULTIPLE
}

model BacktestRun {
  id                  String             @id @default(cuid())
  userId              String
  strategyId          String?
  strategyName        String
  instrumentSymbol    String
  direction           StrategyDirection  @default(LONG)
  startingCapital     Float
  brokeragePercent    Float
  slippagePercent     Float
  positionSizingMode  PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue Float?
  stopLossEnabled     Boolean            @default(false)
  stopLossUnit        RiskUnit?
  stopLossValue       Float?
  targetEnabled       Boolean            @default(false)
  targetUnit          RiskUnit?
  targetValue         Float?
  trailingSlEnabled   Boolean            @default(false)
  trailingSlUnit      RiskUnit?
  trailingSlValue     Float?
  maxPyramidEntries   Int                @default(1)
  range               String
  entryCondition      Json
  exitCondition       Json
  totalReturnPct      Float
  cagrPct             Float
  winRatePct          Float
  profitFactor        Float
  maxDrawdownPct      Float
  sharpeRatio         Float
  expectancy          Float
  tradeCount          Int
  equityCurve         Json
  createdAt           DateTime           @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  trades   BacktestTrade[]
}

model BacktestTrade {
  id            String @id @default(cuid())
  backtestRunId String
  entryTime     Int
  entryPrice    Float
  exitTime      Int
  exitPrice     Float
  quantity      Float
  grossPnl      Float
  fees          Float
  netPnl        Float
  netPnlPct     Float
  holdingBars   Int

  backtestRun BacktestRun @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)
}

enum PaperSessionStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum PaperOrderSide {
  BUY
  SELL
}

model PaperSession {
  id                       String             @id @default(cuid())
  userId                   String
  strategyId               String?
  strategyName             String
  instrumentSymbol         String
  direction                StrategyDirection  @default(LONG)
  entryCondition           Json
  exitCondition            Json
  startingCapital          Float
  brokeragePercent         Float
  slippagePercent          Float
  positionSizingMode       PositionSizingMode @default(FULL_CAPITAL)
  positionSizingValue      Float?
  stopLossEnabled          Boolean            @default(false)
  stopLossUnit             RiskUnit?
  stopLossValue            Float?
  targetEnabled            Boolean            @default(false)
  targetUnit               RiskUnit?
  targetValue              Float?
  trailingSlEnabled        Boolean            @default(false)
  trailingSlUnit           RiskUnit?
  trailingSlValue          Float?
  maxPyramidEntries        Int                @default(1)
  // Alert-only sessions detect and notify on entry/exit signals without
  // ever placing an order or touching cash/position state.
  alertOnly                Boolean            @default(false)
  cash                     Float
  positionEntryTime        Int?
  positionEntryPrice       Float?
  positionQuantity         Float?
  // Persisted so a resumed session's trailing-stop/target math survives
  // across syncs instead of resetting each time (favorableExtreme in
  // particular must carry forward — resetting it to entryPrice every sync
  // would silently defeat the trailing stop). pyramidCount carries forward
  // for the same reason — how many entries have already stacked into the
  // current position.
  positionFavorableExtreme Float?
  positionStopLossPrice    Float?
  positionTargetPrice      Float?
  positionPyramidCount     Int                @default(1)
  lastSyncedTime           Int?
  status                   PaperSessionStatus @default(ACTIVE)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  orders   PaperOrder[]
}

model PaperOrder {
  id             String         @id @default(cuid())
  paperSessionId String
  side           PaperOrderSide
  time           Int
  price          Float
  quantity       Float
  fees           Float
  netPnl         Float?
  createdAt      DateTime       @default(now())

  paperSession PaperSession  @relation(fields: [paperSessionId], references: [id], onDelete: Cascade)
  webhookAlert WebhookAlert?
}

// Append-only log of every call received at a strategy's webhook URL —
// written even when parsing fails, so the "Recent Signals" panel can always
// answer "why did/didn't this fire," the single most common support question
// this kind of feature generates.
model WebhookAlert {
  id           String          @id @default(cuid())
  strategyId   String
  receivedAt   DateTime        @default(now())
  rawPayload   String          @db.Text
  parsedAction PaperOrderSide?
  parseError   String?
  executed     Boolean         @default(false)
  paperOrderId String?         @unique

  strategy   Strategy    @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  paperOrder PaperOrder? @relation(fields: [paperOrderId], references: [id], onDelete: SetNull)

  @@index([strategyId, receivedAt])
}

model RiskSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  killSwitchEnabled    Boolean  @default(false)
  maxLossPercent       Float?
  maxConsecutiveLosses Int?
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RiskEventType {
  KILL_SWITCH_BLOCKED
  MAX_LOSS_HIT
  MAX_CONSECUTIVE_LOSSES_HIT
}

model RiskEvent {
  id             String        @id @default(cuid())
  userId         String
  paperSessionId String?
  type           RiskEventType
  message        String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChartLayout {
  id           String   @id @default(cuid())
  userId       String
  instrumentId String
  config       Json
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
}

enum NotificationType {
  ORDER_FILLED
  RISK_EVENT
  SESSION_STOPPED
  SIGNAL_ALERT
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  message        String
  paperSessionId String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
