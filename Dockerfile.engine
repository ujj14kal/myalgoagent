# The always-on live-strategy engine (AWS Fargate). Built on AWS CodeBuild — see infra/engine.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci
RUN npx prisma generate
COPY src ./src
COPY tsconfig.json ./
RUN npx esbuild src/worker/live-engine.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/engine.js \
    --alias:@=./src --conditions=react-server --external:@prisma/client --external:pg-native --log-level=warning

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY certs ./certs
USER node
CMD ["node", "dist/engine.js"]
